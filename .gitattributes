# Normalize line endings to LF on commit, checkout as OS-native
* text=auto

# Force LF for all source files (consistent across Mac/Windows)
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
